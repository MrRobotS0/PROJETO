@model Projeto.VewModel.HomeViewModel
@{
    ViewData["Title"] = "Início";
}

<section class="hero">
    <div class="hero-bg" style="background-image:url('/imagens/ham4.jpg')"></div>
    <div class="hero-inner">
        <span class="eyebrow">Feito na brasa, na hora</span>
        <h1 class="mt-3">Matou a <span class="flame">fome</span>?<br />peça agora</h1>
        <p>Hambúrgueres artesanais suculentos, batatas crocantes e milk-shakes cremosos. Do balcão pra sua casa em minutos.</p>
        <div class="hero-actions">
            <a class="btn-brand btn-lg-cta" asp-controller="Item" asp-action="List">
                <i class="bi bi-bag" aria-hidden="true"></i> Ver cardápio
            </a>
            <a class="btn-gold btn-lg-cta" href="#destaques">Ver destaques</a>
        </div>
    </div>
</section>

<section id="destaques">
    <div class="d-flex align-items-end justify-content-between flex-wrap gap-2 mb-4">
        <div>
            <span class="eyebrow">Os queridinhos</span>
            <h2 class="section-display mt-2 mb-0">Lanches <span class="accent">especiais</span></h2>
        </div>
        <a class="btn-brand-outline" asp-controller="Item" asp-action="List">Ver todos <i class="bi bi-arrow-right"></i></a>
    </div>

    @if (Model?.ItensEmDestaque != null && Model.ItensEmDestaque.Any())
    {
        <div class="menu-grid">
            @foreach (var item in Model.ItensEmDestaque)
            {
                <partial name="_Card" for="@item" />
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="ico"><i class="bi bi-emoji-frown" style="font-size:2rem" aria-hidden="true"></i></div>
            <h3>Ainda sem destaques</h3>
            <p>Volte em breve — estamos preparando novidades na chapa.</p>
        </div>
    }
</section>
