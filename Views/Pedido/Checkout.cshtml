@model Pedido
@{
    ViewData["Title"] = "Finalizar pedido";
}

<div class="form-card wide">
    <div class="form-head">
        <span class="ico"><i class="bi bi-truck" style="font-size:1.5rem" aria-hidden="true"></i></span>
        <h1 class="panel-title mb-1">Dados de entrega</h1>
        <p class="text-muted mb-0">Você está a um passo de matar a fome.</p>
    </div>

    <form asp-controller="Pedido" asp-action="Checkout" method="post" role="form">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" class="form-control" autocomplete="name" />
                <span asp-validation-for="Nome" class="field-error"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Endereco1"></label>
                <input asp-for="Endereco1" class="form-control" autocomplete="address-line1" />
                <span asp-validation-for="Endereco1" class="field-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Numero"></label>
                <input asp-for="Numero" class="form-control" inputmode="numeric" />
                <span asp-validation-for="Numero" class="field-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Endereco2"></label>
                <input asp-for="Endereco2" class="form-control" autocomplete="address-line2" />
                <span asp-validation-for="Endereco2" class="field-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Bairro"></label>
                <input asp-for="Bairro" class="form-control" />
                <span asp-validation-for="Bairro" class="field-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Cep"></label>
                <input asp-for="Cep" class="form-control" inputmode="numeric" autocomplete="postal-code" />
                <span asp-validation-for="Cep" class="field-error"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Cidade"></label>
                <input asp-for="Cidade" class="form-control" value="Araçatuba" autocomplete="address-level2" />
                <span asp-validation-for="Cidade" class="field-error"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Estado"></label>
                <input asp-for="Estado" class="form-control" value="SP" autocomplete="address-level1" />
                <span asp-validation-for="Estado" class="field-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Telefone"></label>
                <input asp-for="Telefone" class="form-control" type="tel" autocomplete="tel" />
                <span asp-validation-for="Telefone" class="field-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4 flex-wrap">
            <a class="btn-brand-outline" asp-controller="Carrinho" asp-action="Index">
                <i class="bi bi-arrow-left" aria-hidden="true"></i> Voltar ao carrinho
            </a>
            <button type="submit" class="btn-brand btn-lg-cta">
                Concluir pedido <i class="bi bi-check2-circle" aria-hidden="true"></i>
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
