@model Pedido
@{
    ViewData["Title"] = "Pedido confirmado";
}

<div class="panel text-center mb-4" style="background:linear-gradient(135deg,var(--brand-red),var(--brand-gold-bright));color:#fff;border:none">
    <div style="font-size:3rem;line-height:1"><i class="bi bi-check-circle-fill" aria-hidden="true"></i></div>
    <h1 class="panel-title mt-2 mb-1" style="color:#fff">@ViewBag.CheckoutCompletoMensagem</h1>
    <p class="mb-0" style="color:rgba(255,255,255,.9)">Seu pedido já está sendo preparado na brasa.</p>
</div>

<div class="panel">
    <div class="row g-3 mb-4">
        <div class="col-md-4"><small class="text-muted d-block">Cliente</small><strong>@Model.Nome</strong></div>
        <div class="col-md-4"><small class="text-muted d-block">Nº do pedido</small><strong>#@Model.PedidoId</strong></div>
        <div class="col-md-4"><small class="text-muted d-block">Data</small><strong>@Model.PedidoEnviado.ToString("dd/MM/yyyy HH:mm")</strong></div>
    </div>

    <div class="table-responsive">
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Qtd.</th>
                    <th>Lanche</th>
                    <th class="num">Preço</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.PedidoItens)
                {
                    <tr>
                        <td><span class="qty-pill">@item.Quantidade</span></td>
                        <td class="fw-semibold">@item.Item?.Nome</td>
                        <td class="num">@item.Preco.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="2" class="num">Total do pedido</td>
                    <td class="num"><span class="cart-total">@(((decimal)ViewBag.TotalPedido).ToString("C"))</span></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="text-center mt-4">
        <a class="btn-brand btn-lg-cta" asp-controller="Home" asp-action="Index">
            <i class="bi bi-house" aria-hidden="true"></i> Voltar ao início
        </a>
    </div>
</div>
