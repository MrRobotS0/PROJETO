@model RegistroViewModel
@{
    ViewData["Title"] = "Cadastrar";
}

<div class="form-card wide">
    <div class="form-head">
        <span class="ico"><i class="bi bi-person-plus-fill" style="font-size:1.6rem" aria-hidden="true"></i></span>
        <h1 class="panel-title mb-1">Criar conta</h1>
        <p class="text-muted mb-0">Rapidinho — e você já pode pedir.</p>
    </div>

    <form asp-controller="Account" asp-action="Register" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="UserName"></label>
                <input asp-for="UserName" class="form-control" autocomplete="username" />
                <span asp-validation-for="UserName" class="field-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>
            <div class="col-12">
                <label asp-for="Nome"></label>
                <input asp-for="Nome" class="form-control" autocomplete="name" />
                <span asp-validation-for="Nome" class="field-error"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Endereco"></label>
                <input asp-for="Endereco" class="form-control" autocomplete="address-line1" />
                <span asp-validation-for="Endereco" class="field-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Numero"></label>
                <input asp-for="Numero" class="form-control" inputmode="numeric" />
                <span asp-validation-for="Numero" class="field-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Bairro"></label>
                <input asp-for="Bairro" class="form-control" />
                <span asp-validation-for="Bairro" class="field-error"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Cidade"></label>
                <input asp-for="Cidade" class="form-control" autocomplete="address-level2" />
                <span asp-validation-for="Cidade" class="field-error"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Estado"></label>
                <input asp-for="Estado" class="form-control" autocomplete="address-level1" />
                <span asp-validation-for="Estado" class="field-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Cep"></label>
                <input asp-for="Cep" class="form-control" inputmode="numeric" autocomplete="postal-code" />
                <span asp-validation-for="Cep" class="field-error"></span>
            </div>
        </div>

        <button type="submit" class="btn-brand w-100 btn-lg-cta mt-4">Criar conta</button>

        <p class="text-center mt-3 mb-0">
            Já tem conta? <a asp-controller="Account" asp-action="Login" class="fw-semibold">Entrar</a>
        </p>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
