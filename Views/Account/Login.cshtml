@model LoginViewModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="form-card">
    <div class="form-head">
        <span class="ico"><i class="bi bi-person-fill" style="font-size:1.6rem" aria-hidden="true"></i></span>
        <h1 class="panel-title mb-1">Entrar</h1>
        <p class="text-muted mb-0">Bom te ver de novo!</p>
    </div>

    <form asp-controller="Account" asp-action="Login" method="post" role="form">
        <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="mb-3">
            <label asp-for="UserName"></label>
            <input asp-for="UserName" class="form-control" autocomplete="username" />
            <span asp-validation-for="UserName" class="field-error"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <button type="submit" class="btn-brand w-100 btn-lg-cta mt-2">Entrar</button>

        <p class="text-center mt-3 mb-0">
            Ainda não tem conta? <a asp-controller="Account" asp-action="Register" class="fw-semibold">Cadastre-se</a>
        </p>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
