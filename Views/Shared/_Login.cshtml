@using Microsoft.AspNetCore.Identity
@inject SignInManager<UserAccount> SignInManager
@if (SignInManager.IsSignedIn(User))
{
    <div class="d-flex align-items-center gap-2">
        <span class="logout-link d-none d-lg-inline"><i class="bi bi-person-circle me-1" aria-hidden="true"></i>@User.Identity.Name</span>
        <form asp-area="" asp-controller="Account" asp-action="Logout" id="logoutForm" method="post" class="m-0">
            <button type="submit" class="btn btn-brand-outline btn-sm text-white" style="border-color:rgba(255,255,255,.4)">
                <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Sair
            </button>
        </form>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2">
        <a class="logout-link" asp-controller="Account" asp-action="Login"
           asp-route-returnUrl="@string.Format("{0}{1}", Context.Request.Path, Context.Request.QueryString)">
            <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Entrar
        </a>
        <a class="btn btn-gold btn-sm" asp-controller="Account" asp-action="Register">Cadastrar</a>
    </div>
}
