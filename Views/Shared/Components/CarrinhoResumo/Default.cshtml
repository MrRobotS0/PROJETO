@model CarrinhoViewModel
@{
    var qtd = Model?.Carrinho?.CarrinhoItens?.Count ?? 0;
}
<a class="cart-pill" asp-controller="Carrinho" asp-action="Index" aria-label="Ver carrinho (@qtd itens)">
    <i class="bi bi-bag" aria-hidden="true"></i>
    <span class="d-none d-lg-inline">Carrinho</span>
    @if (qtd > 0)
    {
        <span class="count">@qtd</span>
    }
</a>
