@model Item
<article class="dish-card">
    <a class="media" asp-controller="Item" asp-action="Details" asp-route-id="@Model.ItemId"
       aria-label="Ver detalhes de @Model.Nome">
        <img src="~/@Model.ImagemPequenaUrl" alt="@Model.Nome" loading="lazy" asp-append-version="true" />
        <span class="price-chip">@Model.Preco.ToString("C")</span>
    </a>
    <div class="body">
        @if (Model.Categoria != null)
        {
            <span class="cat-badge">@Model.Categoria.Nome</span>
        }
        <h3 class="title">
            <a asp-controller="Item" asp-action="Details" asp-route-id="@Model.ItemId">@Model.Nome</a>
        </h3>
        <p class="desc">@Model.DescricaoCurta</p>
        <div class="actions">
            <a class="btn-brand" asp-controller="Carrinho" asp-action="AdicionarItemNoCarrinhoCompra"
               asp-route-itemId="@Model.ItemId">
                <i class="bi bi-bag-plus" aria-hidden="true"></i> Adicionar ao carrinho
            </a>
        </div>
    </div>
</article>
