<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brasa Burger</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PROJETO.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
</head>

<body>
    <a class="skip-link" href="#main">Pular para o conteúdo</a>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark brasa-nav">
            <div class="container">
                <a class="navbar-brand brasa-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M3 13.5h18M4 17.5h16a0 0 0 0 1 0 0 2 2 0 0 1-2 2H6a2 2 0 0 1-2-2 0 0 0 0 1 0 0Z" fill="#fff"/>
                            <path d="M4 10.5C4 7 7.6 4.5 12 4.5s8 2.5 8 6H4Z" fill="#fff"/>
                            <circle cx="8" cy="8" r="0.9" fill="#DC2626"/><circle cx="12" cy="7.2" r="0.9" fill="#DC2626"/><circle cx="16" cy="8" r="0.9" fill="#DC2626"/>
                        </svg>
                    </span>
                    Brasa<span class="brand-red">Burger</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Abrir menu de navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNav">
                    <ul class="navbar-nav align-items-lg-center gap-lg-1 me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Início</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Item" asp-action="List">Cardápio</a>
                        </li>
                        <li class="nav-item">
                            @await Component.InvokeAsync("CategoriaMenu")
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="Admin" asp-action="Index">Admin</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-2">
                        <li class="nav-item">
                            <form class="brasa-search d-flex" asp-controller="Item" asp-action="Search" method="get" role="search">
                                <i class="bi bi-search search-ico" aria-hidden="true"></i>
                                <input type="search" name="searchString" value="@ViewData["searchString"]"
                                       placeholder="Buscar lanche..." aria-label="Buscar lanche no cardápio" />
                                <button class="search-btn" type="submit" aria-label="Buscar">
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </button>
                            </form>
                        </li>
                        <li class="nav-item">
                            @await Component.InvokeAsync("CarrinhoResumo")
                        </li>
                        <li class="nav-item">
                            @await Html.PartialAsync("_Login")
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="main" role="main" class="py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="brasa-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <span class="navbar-brand brasa-brand" style="color:#fff">
                        <span class="brand-mark" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M4 17.5h16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z" fill="#fff"/>
                                <path d="M4 10.5C4 7 7.6 4.5 12 4.5s8 2.5 8 6H4Z" fill="#fff"/>
                                <rect x="3" y="12.6" width="18" height="2" rx="1" fill="#fff"/>
                            </svg>
                        </span>
                        Brasa<span class="brand-red">Burger</span>
                    </span>
                    <p class="mt-3 mb-0" style="color:rgba(255,255,255,.7); max-width:34ch">
                        Hambúrgueres artesanais na brasa, feitos na hora com ingredientes fresquinhos.
                    </p>
                </div>
                <div class="col-6 col-lg-3">
                    <h5>Contato</h5>
                    <p class="mb-1"><i class="bi bi-telephone me-2" aria-hidden="true"></i>(18) 99999-9999</p>
                    <p class="mb-1"><i class="bi bi-geo-alt me-2" aria-hidden="true"></i>Araçatuba, SP</p>
                    <p class="mb-0"><i class="bi bi-clock me-2" aria-hidden="true"></i>Ter–Dom, 18h–23h</p>
                </div>
                <div class="col-6 col-lg-3">
                    <h5>Navegar</h5>
                    <p class="mb-1"><a asp-controller="Home" asp-action="Index">Início</a></p>
                    <p class="mb-1"><a asp-controller="Item" asp-action="List">Cardápio</a></p>
                    <p class="mb-0"><a asp-controller="Carrinho" asp-action="Index">Meu carrinho</a></p>
                </div>
                <div class="col-lg-2">
                    <h5>Siga a gente</h5>
                    <div class="socials">
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram" aria-hidden="true"></i></a>
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook" aria-hidden="true"></i></a>
                        <a href="#" aria-label="X (Twitter)"><i class="bi bi-twitter-x" aria-hidden="true"></i></a>
                    </div>
                </div>
            </div>
            <div class="copy text-center">
                © @DateTime.Now.Year Brasa Burger — Todos os direitos reservados.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
