<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brasa Burger Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PROJETO.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark brasa-nav">
            <div class="container">
                <a class="navbar-brand brasa-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    Brasa<span class="brand-red">Burger</span>
                    <span class="badge ms-2" style="background:var(--brand-gold-bright);color:#3a1d00">Admin</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav"
                    aria-controls="adminNav" aria-expanded="false" aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="adminNav">
                    <ul class="navbar-nav gap-lg-1 me-auto">
                        <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Admin" asp-action="Index">Painel</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="AdminItem" asp-action="Index">Itens</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="AdminCategoria" asp-action="Index">Categorias</a></li>
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-2">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-box-arrow-up-right me-1"></i>Ver site</a></li>
                        <li class="nav-item">@await Html.PartialAsync("_Login")</li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="main" role="main" class="py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="brasa-footer">
        <div class="container">
            <div class="copy text-center" style="border:none;margin:0;padding:0">
                © @DateTime.Now.Year Brasa Burger — Painel administrativo.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
